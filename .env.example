# Copy this file to .env and fill in real local-only values.
# Never commit real API keys, device keys, or upload tokens.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

# Shared secret used by edge devices when calling server ingest/control APIs.
EDGE_INGEST_API_KEY=

# Shared secret used by edge devices when uploading clips to the Orin/server API.
CLIP_UPLOAD_API_KEY=

# Shared secret used by callers of the edge /clip/request REST endpoint.
EDGE_CLIP_REQUEST_API_KEY=
